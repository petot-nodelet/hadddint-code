package web

// PageData is passed to every rendered page.
type PageData struct {
	Title       string
	Description string
	CSRF        string
	Nav         NavProps
}

templ Layout(page PageData, content templ.Component) {
	<!DOCTYPE html>
	<html lang="id">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ page.Title }</title>
			<meta name="description" content={ page.Description }/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Alex+Brush&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body class="bg-canvas text-ink antialiased">
			@Navbar(page.Nav)
			<main>
				@content
			</main>
			@Footer()
		</body>
	</html>
}
