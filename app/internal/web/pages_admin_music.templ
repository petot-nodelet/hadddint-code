package web

import (
	"fmt"
)

templ AdminMusicPage(data AdminMusicPageData) {
	@Layout(data.Page, adminMusicContent(data))
}

templ adminMusicContent(data AdminMusicPageData) {
	<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-12">
		<a class="text-sm text-gold hover:underline" href="/admin">← Admin</a>
		<p class="mt-5 text-xs font-semibold uppercase tracking-[0.3em] text-gold">Library musik</p>
		<h1 class="mt-2 font-serif text-3xl">Kelola pilihan musik</h1>
		<p class="mt-3 text-sm leading-relaxed text-ink-muted">Unggah hanya audio yang telah memiliki izin penggunaan. Audio berformat MP3/OGG maksimal 5 MiB. File library tidak disajikan sebagai konten publik.</p>
		if data.Error != "" {
			<p role="alert" class="mt-5 rounded-lg border border-red-900 bg-red-950/50 p-3 text-sm text-red-200">{ data.Error }</p>
		}
		<div class="card mt-6 p-5 sm:p-7">
			<h2 class="font-serif text-xl">Tambah pilihan audio</h2>
			<form method="post" enctype="multipart/form-data" action="/admin/music" class="mt-4 grid gap-4 sm:grid-cols-2">
				<input type="hidden" name="csrf_token" value={ data.Page.CSRF }/>
				<label class="form-label">
					<span>Judul musik</span>
					<input class="form-input" type="text" name="title" required maxlength="120"/>
				</label>
				<label class="form-label">
					<span>File audio</span>
					<input class="form-input" type="file" name="audio" accept="audio/mpeg,audio/ogg" required/>
				</label>
				<button class="btn btn-primary sm:col-span-2" type="submit">Unggah musik</button>
			</form>
		</div>
		<div class="card mt-6 p-5 sm:p-7">
			<h2 class="font-serif text-xl">Daftar audio</h2>
			if len(data.Tracks) == 0 {
				<p class="mt-3 text-sm text-ink-muted">Belum ada audio terdaftar.</p>
			} else {
				<div class="mt-4 divide-y divide-line">
					for _, track := range data.Tracks {
						<div class="grid gap-3 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
							<div>
								<p class="font-semibold">{ track.Title }</p>
								<p class="mt-1 text-xs text-ink-muted">{ track.MimeType } · { fmt.Sprint(track.SizeBytes) } bytes · { musicTrackStatus(track.IsActive) }</p>
								<audio class="mt-3 w-full max-w-md" controls preload="none">
									<source src={ adminMusicURL(track.ID) } type={ track.MimeType }/>
								</audio>
							</div>
							<form method="post" action={ fmt.Sprintf("/admin/music/%d/active", track.ID) }>
								<input type="hidden" name="csrf_token" value={ data.Page.CSRF }/>
								if track.IsActive == 1 {
									<input type="hidden" name="active" value="0"/>
									<button class="btn btn-outline" type="submit">Nonaktifkan</button>
								} else {
									<input type="hidden" name="active" value="1"/>
									<button class="btn btn-primary" type="submit">Aktifkan</button>
								}
							</form>
						</div>
					}
				</div>
			}
		</div>
	</section>
}
