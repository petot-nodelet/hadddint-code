package web

import (
	"fmt"
	"net/url"
)

templ AdminInvitationReviewPage(data AdminInvitationPageData) {
	@Layout(data.Page, adminInvitationReviewContent(data))
}

templ adminInvitationReviewContent(data AdminInvitationPageData) {
	<section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-12">
		<div class="flex flex-wrap items-start justify-between gap-4">
			<div>
				<a class="text-sm text-gold hover:underline" href={ templ.SafeURL("/admin/orders/" + url.PathEscape(data.Order.OrderNumber)) }>← Detail pesanan</a>
				<p class="mt-4 text-xs font-semibold uppercase tracking-[0.3em] text-gold">Review undangan</p>
				<h1 class="mt-2 font-serif text-3xl">{ data.Order.OrderNumber }</h1>
				<p class="mt-2 text-sm text-ink-muted">{ data.Order.PackageName } · { data.Order.TemplateName } · Versi draft { fmt.Sprint(data.Order.DraftVersion) }</p>
			</div>
			<a class="btn btn-outline" href={ templ.SafeURL("/admin/orders/" + url.PathEscape(data.Order.OrderNumber) + "/invitation/preview") }>Pratinjau privat</a>
		</div>
		<div class="card mt-6 p-5 sm:p-7">
			<h2 class="font-serif text-xl">Status review</h2>
			<p class="mt-2 text-sm">Status saat ini: <strong>{ invitationReviewStatusLabel(data.Order.InvitationReviewStatus) }</strong></p>
			if data.Order.InvitationReviewNote != "" {
				<p class="mt-2 whitespace-pre-line text-sm text-ink-muted">{ data.Order.InvitationReviewNote }</p>
			}
			<form method="post" action={ templ.SafeURL("/admin/orders/" + url.PathEscape(data.Order.OrderNumber) + "/invitation/review") } class="mt-4 grid gap-3 sm:grid-cols-[14rem_minmax(0,1fr)_auto]">
				<input type="hidden" name="csrf_token" value={ data.Page.CSRF }/>
				<label class="form-label">
					<span>Status</span>
					<select class="form-input" name="review_status" required>
						for _, status := range invitationReviewStatuses() {
							if status.Value == data.Order.InvitationReviewStatus {
								<option value={ status.Value } selected>{ status.Label }</option>
							} else {
								<option value={ status.Value }>{ status.Label }</option>
							}
						}
					</select>
				</label>
				<label class="form-label">
					<span>Catatan untuk pelanggan</span>
					<textarea class="form-input min-h-20" name="review_note" maxlength="1000">{ data.Order.InvitationReviewNote }</textarea>
				</label>
				<button class="btn btn-primary sm:mt-6" type="submit">Simpan review</button>
			</form>
		</div>
		<div class="mt-6 grid gap-4 sm:grid-cols-2">
			for _, module := range data.Modules {
				<article class="card p-5">
					<div class="flex flex-wrap items-start justify-between gap-2">
						<h2 class="font-serif text-xl">{ module.Title }</h2>
						if module.Available {
							if module.Complete {
								<span class="text-xs font-semibold text-green-700">Lengkap</span>
							} else {
								<span class="text-xs text-ink-muted">Belum lengkap</span>
							}
						} else {
							<span class="text-xs text-ink-muted">Tidak termasuk paket</span>
						}
					</div>
					if len(module.Fields) == 0 && len(module.Items) == 0 {
						<p class="mt-3 text-sm text-ink-muted">Belum ada data.</p>
					}
					for _, value := range module.Fields {
						<div class="mt-3">
							<p class="text-xs font-semibold uppercase tracking-wider text-ink-muted">{ value.Label }</p>
							<p class="mt-1 whitespace-pre-line break-words text-sm">{ value.Value }</p>
						</div>
					}
					for index, item := range module.Items {
						<div class="mt-4 rounded-lg border border-line p-3">
							<p class="text-xs font-semibold uppercase tracking-wider text-gold">Item { fmt.Sprint(index + 1) }</p>
							for _, value := range item {
								<p class="mt-2 text-sm"><strong>{ value.Label }:</strong> { value.Value }</p>
							}
						</div>
					}
				</article>
			}
		</div>
		<div class="card mt-6 p-5 sm:p-7">
			<h2 class="font-serif text-xl">Media privat</h2>
			if len(data.Media) == 0 {
				<p class="mt-3 text-sm text-ink-muted">Belum ada media.</p>
			} else {
				<ul class="mt-3 divide-y divide-line">
					for _, media := range data.Media {
						<li class="flex flex-wrap items-center justify-between gap-3 py-3">
							<div>
								<p class="font-semibold">{ media.MediaType } · #{ fmt.Sprint(media.ID) }</p>
								<p class="text-xs text-ink-muted">{ media.MimeType } · { fmt.Sprint(media.SizeBytes) } bytes</p>
							</div>
							<a class="text-sm text-gold hover:underline" href={ templ.SafeURL(fmt.Sprintf("/admin/orders/%s/invitation/media/%d", url.PathEscape(data.Order.OrderNumber), media.ID)) }>Buka media</a>
						</li>
					}
				</ul>
			}
		</div>
	</section>
}
