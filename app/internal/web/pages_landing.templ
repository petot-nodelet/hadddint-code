package web

import (
	"fmt"

	"github.com/sukamoto/app/internal/storage"
)

type PackageCard struct {
	Pkg      storage.PackageRow
	Features []string
}

type LandingData struct {
	Page      PageData
	Templates []storage.Template
	Packages  []PackageCard
}

templ Hero() {
	<section class="relative overflow-hidden">
		<div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:py-28">
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Digital Wedding Invitation</p>
				<h1 class="mt-4 font-serif text-4xl leading-tight sm:text-5xl">
					Undangan pernikahan <span class="script text-gold">elegan</span> dalam hitungan menit
				</h1>
				<p class="mt-5 max-w-md leading-relaxed text-ink-muted">
					Buat, personalisasi, dan bagikan undangan digital Anda melalui satu link indah.
					Tanpa coding, tanpa ribet, cukup isi data — kami yang wujudkan.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href="/templates" class="btn btn-primary">Buat Undangan</a>
					<a href="/templates" class="btn btn-outline">Lihat Template</a>
				</div>
				<p class="mt-6 text-sm text-ink-muted">✓ Responsive smartphone ✓ Link personal ✓ Bagikan via WhatsApp</p>
			</div>
			<div class="relative mx-auto w-full max-w-sm">
				<div class="phone-frame">
					<div class="phone-screen bg-cover bg-center" style="background-image:url('/index/photo-1511285560929-80b456fea0bc.jpg')">
						<div class="flex h-full flex-col items-center justify-center bg-ink/40 text-center text-canvas">
							<p class="text-xs uppercase tracking-[0.35em]">The Wedding of</p>
							<p class="script mt-2 text-4xl">Raka &amp; Senja</p>
							<p class="mt-3 text-sm">Sabtu, 12 Desember 2026</p>
							<p class="mt-1 text-sm">Bandung, Jawa Barat</p>
							<span class="mt-6 rounded-full border border-canvas/60 px-4 py-1.5 text-xs">Buka Undangan</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
}

templ FeaturedTemplates(items []storage.Template) {
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<div class="flex items-end justify-between">
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Pilihan Desain</p>
				<h2 class="mt-2 font-serif text-3xl">Template Unggulan</h2>
			</div>
			<a href="/templates" class="text-sm font-medium text-gold hover:underline">Semua template →</a>
		</div>
		<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			for _, t := range items {
				@TemplateCard(t)
			}
		</div>
	</section>
}

templ TemplateCard(t storage.Template) {
	<article class="card group overflow-hidden">
		<a href={ templ.SafeURL("/templates/" + t.ID) } class="block">
			<div class="thumb relative aspect-[3/4] overflow-hidden bg-sand">
				if t.Thumbnail != "" {
					<img src={ t.Thumbnail } alt={ t.Name } loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105"/>
				} else {
					<div class="flex h-full items-center justify-center font-serif text-ink-muted">{ t.Name }</div>
				}
				<span class="absolute left-3 top-3 badge badge-gold">{ upper(t.PackageID) }</span>
			</div>
		</a>
		<div class="p-4">
			<h3 class="font-serif text-lg">{ t.Name }</h3>
			<p class="mt-1 text-xs uppercase tracking-widest text-ink-muted">{ t.Category }</p>
			<p class="mt-2 line-clamp-2 text-sm text-ink-muted">{ t.Description }</p>
			<div class="mt-4 flex gap-2">
				<a href={ templ.SafeURL("/templates/" + t.ID) } class="btn btn-outline flex-1 text-sm">Preview</a>
				<a href={ templ.SafeURL("/templates/" + t.ID + "#select") } class="btn btn-primary flex-1 text-sm">Gunakan</a>
			</div>
		</div>
	</article>
}

// upper helper is defined in helpers.go
templ HowItWorks() {
	<section id="how" class="bg-sand py-16">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<p class="text-center text-xs font-semibold uppercase tracking-[0.3em] text-gold">Alur Order</p>
			<h2 class="mt-2 text-center font-serif text-3xl">Cara Kerja SUKAMOTO</h2>
			<ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				<li class="step"><span class="step-num">1</span><h3 class="step-title">Pilih Paket</h3><p class="step-desc">Silver atau Gold sesuai kebutuhan.</p></li>
				<li class="step"><span class="step-num">2</span><h3 class="step-title">Pilih Template</h3><p class="step-desc">Pratinjau desain sebelum memutuskan.</p></li>
				<li class="step"><span class="step-num">3</span><h3 class="step-title">Isi Data Undangan</h3><p class="step-desc">Form modular per bagian, tersimpan bertahap.</p></li>
				<li class="step"><span class="step-num">4</span><h3 class="step-title">Bayar &amp; Verifikasi</h3><p class="step-desc">QRIS / transfer, diverifikasi admin.</p></li>
				<li class="step"><span class="step-num">5</span><h3 class="step-title">Undangan Aktif</h3><p class="step-desc">Data diproses dan diaktifkan.</p></li>
				<li class="step"><span class="step-num">6</span><h3 class="step-title">Bagikan Link</h3><p class="step-desc">Kirim ke tamu via WhatsApp.</p></li>
			</ol>
		</div>
	</section>
}

templ Pricing(cards []PackageCard) {
	<section id="pricing" class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<p class="text-center text-xs font-semibold uppercase tracking-[0.3em] text-gold">Harga</p>
		<h2 class="mt-2 text-center font-serif text-3xl">Paket Layanan</h2>
		<div class="mt-10 grid gap-6 lg:grid-cols-3">
			for _, c := range cards {
				@PackageCardView(c)
			}
		</div>
	</section>
}

templ PackageCardView(c PackageCard) {
	<div class={ fmt.Sprintf("card p-6 flex flex-col %s %s", ifElse(c.Pkg.ComingSoon, "opacity-60", ""), ifElse(c.Pkg.ID == "gold", "ring-2 ring-gold", "")) }>
		<div class="flex items-center justify-between">
			<h3 class="font-serif text-2xl">{ c.Pkg.Name }</h3>
			if c.Pkg.ComingSoon {
				<span class="badge badge-line">Coming Soon</span>
			} else if c.Pkg.ID == "gold" {
				<span class="badge badge-gold">Populer</span>
			}
		</div>
		<p class="mt-1 text-sm text-ink-muted">{ c.Pkg.Tagline }</p>
		if c.Pkg.PriceCents > 0 {
			<p class="mt-5 text-3xl font-semibold">{ FormatIDR(c.Pkg.PriceCents) }</p>
			<p class="text-xs text-ink-muted">per undangan · aktif { fmt.Sprintf("%d", c.Pkg.DurationDays) } hari</p>
		}
		<ul class="mt-6 flex-1 space-y-2 text-sm">
			for _, f := range c.Features {
				<li class="flex gap-2"><span class="text-gold">✓</span><span>{ f }</span></li>
			}
		</ul>
		<div class="mt-6">
			if c.Pkg.Available && !c.Pkg.ComingSoon {
				<a href={ templ.SafeURL("/templates?package=" + c.Pkg.ID) } class="btn btn-primary w-full">Pilih { c.Pkg.Name }</a>
			} else {
				<button class="btn btn-outline w-full" disabled>Tersedia Segera</button>
			}
		</div>
	</div>
}

templ Advantages() {
	<section class="bg-ink py-16 text-canvas">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<h2 class="text-center font-serif text-3xl">Kenapa SUKAMOTO?</h2>
			<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				<div class="adv"><h3>Mudah Digunakan</h3><p>Sistem terstruktur, cocok untuk pengguna awam sekalipun.</p></div>
				<div class="adv"><h3>Tanpa Coding</h3><p>Cukup isi formulir, undangan Anda langsung jadi.</p></div>
				<div class="adv"><h3>Responsive</h3><p>Tampil sempurna di smartphone, tablet, maupun desktop.</p></div>
				<div class="adv"><h3>Link Personal</h3><p>Setiap pasangan mendapat URL unik dan mudah diingat.</p></div>
				<div class="adv"><h3>Bagi via WhatsApp</h3><p>Satu tombol untuk membagikan undangan ke seluruh tamu.</p></div>
				<div class="adv"><h3>Pemesanan Simpel</h3><p>Bayar, verifikasi, undangan aktif — tanpa drama.</p></div>
			</div>
		</div>
	</section>
}

templ LandingPage(data LandingData) {
	@Layout(data.Page, heroAndSections(data))
}

templ heroAndSections(data LandingData) {
	@Hero()
	@FeaturedTemplates(data.Templates)
	@HowItWorks()
	@Pricing(data.Packages)
	@Advantages()
}

type NavProps struct {
	Authenticated bool
	IsAdmin       bool
	Name          string
	CSRF          string
}

templ Navbar(props NavProps) {
	<nav class="sticky top-0 z-50 bg-canvas/90 backdrop-blur border-b border-line">
		<div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
			<a href="/" class="flex items-baseline gap-1">
				<span class="font-serif text-xl font-semibold tracking-wide text-ink">SUKAMOTO</span>
				<span class="hidden text-xs uppercase tracking-[0.25em] text-gold sm:inline">wedding</span>
			</a>
			<div class="flex items-center gap-4 text-sm sm:gap-6">
				<a href="/" class="nav-link hidden md:inline">Home</a>
				<a href="/templates" class="nav-link hidden sm:inline">Templates</a>
				<a href="/#pricing" class="nav-link hidden sm:inline">Pricing</a>
				<a href="/#how" class="nav-link hidden md:inline">How It Works</a>
				<a href="/track" class="nav-link">Cek Pesanan</a>
				if props.IsAdmin {
					<a href="/admin" class="nav-link">Admin</a>
					<form method="post" action="/logout" class="inline">
						<input type="hidden" name="csrf_token" value={ props.CSRF }/>
						<button type="submit" class="btn btn-ghost text-sm">Keluar</button>
					</form>
				}
				<a href="/templates" class="btn btn-primary"><span class="sm:hidden">Buat</span><span class="hidden sm:inline">Buat Undangan</span></a>
			</div>
		</div>
	</nav>
}

