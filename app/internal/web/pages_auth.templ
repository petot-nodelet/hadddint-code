package web

type AuthPageData struct {
	Page  PageData
	Error string
}

templ AdminLoginPage(data AuthPageData) {
	@Layout(data.Page, adminLoginContent(data))
}

templ adminLoginContent(data AuthPageData) {
	<section class="mx-auto max-w-md px-4 py-16 sm:px-6">
		<div class="card p-6 sm:p-8">
			<p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Akses terbatas</p>
			<h1 class="mt-3 font-serif text-3xl">Masuk Admin</h1>
			if data.Error != "" {
				<p role="alert" class="mt-5 rounded-lg border border-red-900 bg-red-950/50 p-3 text-sm text-red-200">{ data.Error }</p>
			}
			<form method="post" action="/admin/login" class="mt-6 space-y-4">
				<input type="hidden" name="csrf_token" value={ data.Page.CSRF }/>
				<label class="form-label">
					<span>Email admin</span>
					<input class="form-input" type="email" name="email" autocomplete="username" required maxlength="254"/>
				</label>
				<label class="form-label">
					<span>Password</span>
					<input class="form-input" type="password" name="password" autocomplete="current-password" required/>
				</label>
				<button type="submit" class="btn btn-primary w-full">Masuk</button>
			</form>
		</div>
	</section>
}

templ AdminDashboard(page PageData, name string) {
	@Layout(page, adminDashboardContent(name))
}

templ adminDashboardContent(name string) {
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
		<p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Area administrator</p>
		<h1 class="mt-3 font-serif text-3xl">Selamat datang, { name }</h1>
		<p class="mt-4 text-ink-muted">Kelola pesanan dan verifikasi pembayaran dari satu tempat.</p>
		<a href="/admin/orders" class="btn btn-primary mt-7">Lihat pesanan</a>
	</section>
}
