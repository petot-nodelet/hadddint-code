package web

import "fmt"

type AuthPageData struct {
	Page  PageData
	Error string
	Next  string
}

type OrderSummary struct {
	ID           int64
	PackageName  string
	TemplateName string
	Status       string
}

templ LoginPage(data AuthPageData) {
	@Layout(data.Page, loginContent(data))
}

templ loginContent(data AuthPageData) {
	<section class="mx-auto max-w-md px-4 py-16 sm:px-6">
		<div class="card p-6 sm:p-8">
			<p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Selamat datang kembali</p>
			<h1 class="mt-3 font-serif text-3xl">Masuk ke SUKAMOTO</h1>
			if data.Error != "" {
				<p role="alert" class="mt-5 rounded-lg border border-red-900 bg-red-950/50 p-3 text-sm text-red-200">{ data.Error }</p>
			}
			<form method="post" action="/login" class="mt-6 space-y-4">
				<input type="hidden" name="csrf_token" value={ data.Page.CSRF }/>
				<input type="hidden" name="next" value={ data.Next }/>
				<label class="form-label">
					<span>Email</span>
					<input class="form-input" type="email" name="email" autocomplete="email" required maxlength="254"/>
				</label>
				<label class="form-label">
					<span>Password</span>
					<input class="form-input" type="password" name="password" autocomplete="current-password" required/>
				</label>
				<button type="submit" class="btn btn-primary w-full">Masuk</button>
			</form>
			<p class="mt-6 text-center text-sm text-ink-muted">Belum punya akun? <a class="text-gold hover:underline" href="/register">Daftar</a></p>
		</div>
	</section>
}

templ RegisterPage(data AuthPageData) {
	@Layout(data.Page, registerContent(data))
}

templ registerContent(data AuthPageData) {
	<section class="mx-auto max-w-md px-4 py-16 sm:px-6">
		<div class="card p-6 sm:p-8">
			<p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Mulai perjalanan Anda</p>
			<h1 class="mt-3 font-serif text-3xl">Buat akun</h1>
			if data.Error != "" {
				<p role="alert" class="mt-5 rounded-lg border border-red-900 bg-red-950/50 p-3 text-sm text-red-200">{ data.Error }</p>
			}
			<form method="post" action="/register" class="mt-6 space-y-4">
				<input type="hidden" name="csrf_token" value={ data.Page.CSRF }/>
				<input type="hidden" name="next" value={ data.Next }/>
				<label class="form-label">
					<span>Nama lengkap</span>
					<input class="form-input" type="text" name="full_name" autocomplete="name" required minlength="2" maxlength="100"/>
				</label>
				<label class="form-label">
					<span>Email</span>
					<input class="form-input" type="email" name="email" autocomplete="email" required maxlength="254"/>
				</label>
				<label class="form-label">
					<span>Nomor telepon <span class="text-ink-muted">(opsional)</span></span>
					<input class="form-input" type="tel" name="phone" autocomplete="tel" maxlength="30"/>
				</label>
				<label class="form-label">
					<span>Password <span class="text-ink-muted">(minimal 8 karakter)</span></span>
					<input class="form-input" type="password" name="password" autocomplete="new-password" required minlength="8" maxlength="72"/>
				</label>
				<button type="submit" class="btn btn-primary w-full">Daftar</button>
			</form>
			<p class="mt-6 text-center text-sm text-ink-muted">Sudah punya akun? <a class="text-gold hover:underline" href="/login">Masuk</a></p>
		</div>
	</section>
}

templ CustomerDashboard(page PageData, name string, order *OrderSummary) {
	@Layout(page, customerDashboardContent(name, order))
}

templ customerDashboardContent(name string, order *OrderSummary) {
	<section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
		<p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Area pelanggan</p>
		<h1 class="mt-3 font-serif text-3xl">Selamat datang, { name }</h1>
		if order != nil {
			<div class="card mt-7 p-5">
				<p class="text-xs font-semibold uppercase tracking-widest text-gold">Pilihan tersimpan</p>
				<h2 class="mt-2 font-serif text-2xl">Pesanan #{ fmt.Sprintf("%d", order.ID) }</h2>
				<p class="mt-2 text-sm text-ink-muted">{ order.TemplateName } · Paket { order.PackageName }</p>
				<p class="mt-3 text-sm">Status: <span class="font-semibold capitalize text-gold">{ order.Status }</span></p>
				<p class="mt-3 text-xs leading-relaxed text-ink-muted">Pilihan Anda sudah tersimpan sebagai draf. Tahap pengisian undangan dan pembayaran akan tersedia setelah fitur pesanan dilanjutkan.</p>
			</div>
		} else {
			<p class="mt-4 text-ink-muted">Akun Anda aktif. Pilih desain undangan untuk memulai.</p>
			<a href="/templates" class="btn btn-primary mt-8">Jelajahi template</a>
		}
	</section>
}

templ AdminDashboard(page PageData, name string) {
	@Layout(page, adminDashboardContent(name))
}

templ adminDashboardContent(name string) {
	<section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
		<p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Area administrator</p>
		<h1 class="mt-3 font-serif text-3xl">Selamat datang, { name }</h1>
		<p class="mt-4 text-ink-muted">Area ini hanya tersedia untuk akun administrator.</p>
	</section>
}
