package web

import (
	"fmt"
	"net/url"

	"github.com/sukamoto/app/internal/storage"
)

type CatalogPageLink struct {
	Number int
	URL    string
}

type CatalogData struct {
	Page           PageData
	Templates      []storage.Template
	Packages       []storage.PackageRow
	Categories     []string
	PackageID      string
	Category       string
	Search         string
	SortBy         string
	CurrentPage    int
	TotalPages     int
	TotalTemplates int64
	PreviousURL    string
	NextURL        string
	PageLinks      []CatalogPageLink
}

type InvitationPalette struct {
	Background string
	Surface    string
	Accent     string
	Text       string
}

type InvitationTypography struct {
	Heading string
	Body    string
}

type PreviewConfig struct {
	Palette    InvitationPalette    `json:"palette"`
	Typography InvitationTypography `json:"typography"`
	Layout     string               `json:"layout"`
	CoverStyle string               `json:"cover_style"`
	Sections   []string             `json:"sections"`
	Media      PreviewMedia         `json:"media"`
}

type InvitationSample struct {
	Couple     string `json:"couple"`
	Subheading string `json:"subheading"`
	Date       string `json:"date"`
	Location   string `json:"location"`
	Thumbnail  string `json:"thumbnail"`
}

type TemplateDetailData struct {
	Page     PageData
	Template storage.Template
	Config   PreviewConfig
	Sample   InvitationSample
	Error    string
}

type TemplateSelectionData struct {
	Page     PageData
	Template storage.Template
	Package  storage.PackageOption
}

templ TemplateCatalogPage(data CatalogData) {
	@Layout(data.Page, templateCatalogContent(data))
}

templ templateCatalogContent(data CatalogData) {
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
		<div class="mx-auto max-w-2xl text-center">
			<p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Koleksi desain SUKAMOTO</p>
			<h1 class="mt-3 font-serif text-4xl sm:text-5xl">Katalog Template</h1>
			<p class="mt-4 leading-relaxed text-ink-muted">Temukan desain undangan yang paling mencerminkan kisah Anda.</p>
		</div>
		<form method="get" action="/templates" class="card mt-10 grid gap-4 p-4 sm:grid-cols-2 sm:p-5 lg:grid-cols-5">
			<label class="form-label lg:col-span-2">
				<span>Cari template</span>
				<input class="form-input" type="search" name="q" value={ data.Search } placeholder="Nama atau deskripsi" maxlength="100"/>
			</label>
			<label class="form-label">
				<span>Paket</span>
				<select class="form-input" name="package">
					<option value="">Semua paket</option>
					for _, pkg := range data.Packages {
						<option value={ pkg.ID } selected?={ data.PackageID == pkg.ID }>{ pkg.Name }</option>
					}
				</select>
			</label>
			<label class="form-label">
				<span>Kategori</span>
				<select class="form-input" name="category">
					<option value="">Semua kategori</option>
					for _, category := range data.Categories {
						<option value={ category } selected?={ data.Category == category }>{ categoryLabel(category) }</option>
					}
				</select>
			</label>
			<label class="form-label">
				<span>Urutkan</span>
				<select class="form-input" name="sort">
					<option value="featured" selected?={ data.SortBy == "featured" }>Pilihan SUKAMOTO</option>
					<option value="name_asc" selected?={ data.SortBy == "name_asc" }>Nama A–Z</option>
					<option value="name_desc" selected?={ data.SortBy == "name_desc" }>Nama Z–A</option>
					<option value="category" selected?={ data.SortBy == "category" }>Kategori</option>
				</select>
			</label>
			<div class="flex items-end gap-2 sm:col-span-2 lg:col-span-5 lg:justify-end">
				<button class="btn btn-primary w-full sm:w-auto" type="submit">Terapkan filter</button>
				<a class="btn btn-outline w-full sm:w-auto" href="/templates">Reset</a>
			</div>
		</form>
		<div class="mt-7 flex items-center justify-between text-sm text-ink-muted">
			<p>{ fmt.Sprintf("%d", data.TotalTemplates) } desain ditemukan</p>
			if data.TotalPages > 1 {
				<p>Halaman { fmt.Sprintf("%d", data.CurrentPage) } dari { fmt.Sprintf("%d", data.TotalPages) }</p>
			}
		</div>
		if len(data.Templates) == 0 {
			<div class="card mt-4 px-5 py-12 text-center">
				<h2 class="font-serif text-2xl">Belum ada template yang cocok</h2>
				<p class="mt-2 text-sm text-ink-muted">Ubah kata pencarian atau filter paket dan kategori.</p>
				<a class="btn btn-outline mt-5" href="/templates">Lihat semua template</a>
			</div>
		} else {
			<div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				for _, item := range data.Templates {
					@TemplateCard(item)
				}
			</div>
		}
		if data.TotalPages > 1 {
			<nav aria-label="Navigasi halaman katalog" class="mt-10 flex flex-wrap items-center justify-center gap-2">
				if data.PreviousURL != "" {
					<a class="btn btn-outline text-sm" href={ templ.SafeURL(data.PreviousURL) }>Sebelumnya</a>
				}
				for _, page := range data.PageLinks {
					<a class={ fmt.Sprintf("btn text-sm %s", ifElse(page.Number == data.CurrentPage, "btn-primary", "btn-outline")) } aria-current={ ifElse(page.Number == data.CurrentPage, "page", "") } href={ templ.SafeURL(page.URL) }>{ fmt.Sprintf("%d", page.Number) }</a>
				}
				if data.NextURL != "" {
					<a class="btn btn-outline text-sm" href={ templ.SafeURL(data.NextURL) }>Berikutnya</a>
				}
			</nav>
		}
	</section>
}

templ TemplateDetailPage(data TemplateDetailData) {
	@Layout(data.Page, templateDetailContent(data))
}

templ templateDetailContent(data TemplateDetailData) {
	<section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
		<a href="/templates" class="text-sm text-gold hover:underline">← Kembali ke katalog</a>
		<div class="mt-7 grid items-start gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(20rem,0.95fr)] lg:gap-16">
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">{ categoryLabel(data.Template.Category) }</p>
				<h1 class="mt-3 font-serif text-4xl sm:text-5xl">{ data.Template.Name }</h1>
				<p class="mt-4 max-w-2xl leading-relaxed text-ink-muted">{ data.Template.Description }</p>
				if data.Error != "" {
					<p role="alert" class="mt-5 rounded-lg border border-red-900 bg-red-950/50 p-3 text-sm text-red-200">{ data.Error }</p>
				}
				<div class="mt-7">
					@InvitationPreview(data.Config, data.Sample)
				</div>
				<div class="mt-7">
					<h2 class="font-serif text-2xl">Fitur desain</h2>
					if len(data.Template.Features) == 0 {
						<p class="mt-3 text-sm text-ink-muted">Tampilan responsif yang dirancang untuk undangan mobile.</p>
					} else {
						<ul class="mt-3 grid gap-2 sm:grid-cols-2">
							for _, feature := range data.Template.Features {
								<li class="rounded-lg border border-line bg-sand px-3 py-2 text-sm"><span class="text-gold">✦</span> { feature }</li>
							}
						</ul>
					}
				</div>
			</div>
			<aside id="select" class="card p-5 sm:p-6">
				<h2 class="font-serif text-2xl">Gunakan template ini</h2>
				<p class="mt-2 text-sm leading-relaxed text-ink-muted">Pilih paket yang mendukung desain ini. Pilihan akan disimpan sebagai pesanan draf setelah Anda masuk.</p>
				<h3 class="mt-6 text-xs font-semibold uppercase tracking-widest text-gold">Paket yang didukung</h3>
				<ul class="mt-3 space-y-2">
					for _, pkg := range data.Template.Packages {
						<li class="flex items-center justify-between gap-3 rounded-lg border border-line px-3 py-2">
							<span class="font-medium">{ pkg.Name }</span>
							if pkg.Available && !pkg.ComingSoon {
								<span class="badge badge-gold">Tersedia</span>
							} else {
								<span class="badge badge-line">Segera hadir</span>
							}
						</li>
					}
				</ul>
				<form method="post" action={ templ.SafeURL("/templates/" + url.PathEscape(data.Template.ID) + "/use") } class="mt-6 space-y-4">
					<input type="hidden" name="csrf_token" value={ data.Page.CSRF }/>
					<label class="form-label">
						<span>Pilih paket</span>
						<select class="form-input" name="package_id" required>
							for _, pkg := range data.Template.Packages {
								if pkg.Available && !pkg.ComingSoon {
									<option value={ pkg.ID }>{ pkg.Name }</option>
								}
							}
						</select>
					</label>
					if hasAvailablePackage(data.Template.Packages) {
						<button class="btn btn-primary w-full" type="submit">Gunakan template</button>
					} else {
						<button class="btn btn-outline w-full" type="button" disabled>Belum tersedia untuk dipesan</button>
					}
				</form>
				<p class="mt-4 text-xs leading-relaxed text-ink-muted">Belum masuk? Anda akan diarahkan ke login atau registrasi. Pilihan template dan paket tetap terbawa.</p>
			</aside>
		</div>
	</section>
}

templ InvitationPreview(config PreviewConfig, sample InvitationSample) {
	<div class={ fmt.Sprintf("preview-shell preview-layout-%s mx-auto max-w-sm overflow-hidden rounded-[2rem] border border-line p-3 shadow-2xl", config.Layout) } style={ fmt.Sprintf("--preview-bg:%s;--preview-surface:%s;--preview-accent:%s;--preview-text:%s;--preview-heading:'%s';--preview-body:'%s'", config.Palette.Background, config.Palette.Surface, config.Palette.Accent, config.Palette.Text, config.Typography.Heading, config.Typography.Body) }>
		<div class={ fmt.Sprintf("preview-cover preview-cover-%s relative flex aspect-[3/4] flex-col items-center justify-center overflow-hidden rounded-[1.5rem] p-6 text-center", config.CoverStyle) }>
			<img class="absolute inset-0 h-full w-full object-cover" src={ sample.Thumbnail } alt={ sample.Couple } loading="lazy"/>
			<div class="absolute inset-0 bg-black/55"></div>
			<div class="preview-copy relative z-10">
				<p class="text-[0.65rem] uppercase tracking-[0.35em]">The Wedding of</p>
				<p class="preview-couple mt-3 text-5xl">{ sample.Couple }</p>
				<p class="preview-subheading mt-4 text-xs uppercase tracking-[0.2em]">{ sample.Subheading }</p>
				<div class="mx-auto my-5 h-px w-12 bg-[var(--preview-accent)]"></div>
				<p class="text-sm">{ sample.Date }</p>
				<p class="mt-2 text-xs">{ sample.Location }</p>
				<span class="mt-6 inline-flex rounded-full border border-white/60 px-4 py-2 text-xs">Buka Undangan</span>
			</div>
		</div>
		<div class="preview-sections space-y-3 px-3 py-5 text-center">
			for _, section := range config.Sections {
				<div class="preview-section rounded-xl p-4">
					<p class="preview-section-title text-xs font-semibold uppercase tracking-[0.2em]">{ sectionLabel(section) }</p>
					if section == "couple" || section == "story" {
						<p class="preview-couple mt-2 text-3xl">{ sample.Couple }</p>
						<p class="mt-2 text-xs leading-relaxed opacity-75">Dua hati, satu perjalanan, dan kisah yang akan terus tumbuh.</p>
					} else if section == "events" {
						<p class="mt-2 text-xs">{ sample.Date } · { sample.Location }</p>
					} else if section == "gallery" && len(config.Media.Gallery) > 0 {
						<div class="mt-3 grid grid-cols-2 gap-2">
							for _, image := range config.Media.Gallery {
								<img class="aspect-square w-full rounded-lg object-cover" src={ image } alt="Contoh foto galeri undangan" loading="lazy"/>
							}
						</div>
					} else {
						<p class="mt-2 text-xs leading-relaxed opacity-75">Contoh pratinjau undangan dalam tampilan mobile.</p>
					}
				</div>
			}
		</div>
	</div>
}

templ TemplateSelectionPage(data TemplateSelectionData) {
	@Layout(data.Page, templateSelectionContent(data))
}

templ templateSelectionContent(data TemplateSelectionData) {
	<section class="mx-auto max-w-xl px-4 py-16 sm:px-6">
		<div class="card p-6 sm:p-8">
			<p class="text-xs font-semibold uppercase tracking-[0.3em] text-gold">Satu langkah lagi</p>
			<h1 class="mt-3 font-serif text-3xl">Konfirmasi pilihan Anda</h1>
			<p class="mt-4 text-sm leading-relaxed text-ink-muted">Template <strong class="text-ink">{ data.Template.Name }</strong> untuk paket <strong class="text-ink">{ data.Package.Name }</strong> akan disimpan sebagai pesanan draf.</p>
			<form method="post" action={ templ.SafeURL("/templates/" + url.PathEscape(data.Template.ID) + "/use") } class="mt-7 space-y-4">
				<input type="hidden" name="csrf_token" value={ data.Page.CSRF }/>
				<input type="hidden" name="package_id" value={ data.Package.ID }/>
				<button class="btn btn-primary w-full" type="submit">Simpan pilihan &amp; lanjutkan</button>
			</form>
			<a href={ templ.SafeURL("/templates/" + url.PathEscape(data.Template.ID)) } class="btn btn-outline mt-3 w-full">Ubah pilihan</a>
		</div>
	</section>
}
